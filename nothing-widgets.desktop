[Desktop Entry]
Type=Application
Name=Nothing Widgets
GenericName=Desktop Widgets
Comment=Add, remove, and configure desktop widgets
Icon=preferences-desktop
Exec=qs -p /home/pushpank/3level/open/nothing-hyprland-widgets ipc call nothing toggleControl
Terminal=false
